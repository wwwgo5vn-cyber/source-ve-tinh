---
interface Props {
  url: string
  title: string
}

const { url, title } = Astro.props

const encodedUrl   = encodeURIComponent(url)
const encodedTitle = encodeURIComponent(title)

const facebookUrl = `https://www.facebook.com/sharer/sharer.php?u=${encodedUrl}`
const twitterUrl  = `https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`
---

<div class="share-buttons" aria-label="Chia sẻ bài viết">
  <p class="share-buttons__label">Chia sẻ bài viết</p>

  <div class="share-buttons__list">
    <a
      href={facebookUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--facebook"
      aria-label="Chia sẻ lên Facebook"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
      </svg>
      Facebook
    </a>

    <a
      href={twitterUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="share-btn share-btn--twitter"
      aria-label="Chia sẻ lên X (Twitter)"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
      </svg>
      X (Twitter)
    </a>

    <button
      class="share-btn share-btn--copy"
      aria-label="Sao chép đường link"
      data-url={url}
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
      <span class="copy-label">Copy link</span>
    </button>
  </div>
</div>

<script>
document.querySelectorAll('.share-btn--copy').forEach(btn => {
  btn.addEventListener('click', async () => {
    const url = (btn as HTMLButtonElement).dataset.url ?? window.location.href
    const label = btn.querySelector('.copy-label') as HTMLElement
    try {
      await navigator.clipboard.writeText(url)
      label.textContent = 'Đã copy!'
      setTimeout(() => { label.textContent = 'Copy link' }, 2000)
    } catch {
      // Fallback for older browsers
      const ta = document.createElement('textarea')
      ta.value = url
      document.body.appendChild(ta)
      ta.select()
      document.execCommand('copy')
      document.body.removeChild(ta)
      label.textContent = 'Đã copy!'
      setTimeout(() => { label.textContent = 'Copy link' }, 2000)
    }
  })
})
</script>

<style>
.share-buttons {
  margin-top: 2.5rem;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.share-buttons__label {
  font-family: var(--font-ui);
  font-size: var(--size-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  color: var(--color-muted);
  margin-bottom: .75rem;
}

.share-buttons__list {
  display: flex;
  gap: .65rem;
  flex-wrap: wrap;
}

.share-btn {
  display: inline-flex;
  align-items: center;
  gap: .45rem;
  padding: .5rem 1rem;
  border-radius: 6px;
  font-family: var(--font-ui);
  font-size: var(--size-sm);
  font-weight: 500;
  cursor: pointer;
  border: 1px solid var(--color-border);
  background: var(--color-surface);
  color: var(--color-text);
  text-decoration: none;
  transition: background .15s, border-color .15s;
}
.share-btn:hover { background: var(--color-accent-light); border-color: var(--color-accent); opacity: 1; }

.share-btn--facebook { color: #1877f2; }
.share-btn--facebook:hover { background: #e7f0fd; border-color: #1877f2; }

.share-btn--twitter { color: #000; }

.share-btn--copy { background: var(--color-surface); }
</style>
