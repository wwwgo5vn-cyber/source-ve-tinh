---
import TagBadge from './TagBadge.astro'

interface Props {
  title: string
  slug: string
  date: string
  tags: string[]
  excerpt: string
  cover?: string
}

const { title, slug, date, tags, excerpt, cover } = Astro.props

const formattedDate = new Date(date).toLocaleDateString('vi-VN', {
  year: 'numeric', month: 'long', day: 'numeric'
})
---
<article class="post-card">
  {cover && (
    <a href={`/${slug}`} class="post-card__thumb" tabindex="-1" aria-hidden="true">
      <img src={cover} alt={title} width="800" height="450" loading="lazy" />
    </a>
  )}

  <div class="post-card__body">
    <div class="post-card__tags">
      {tags.map(tag => <TagBadge tag={tag} />)}
    </div>
    <h2 class="post-card__title">
      <a href={`/${slug}`}>{title}</a>
    </h2>
    <p class="post-card__excerpt">{excerpt}</p>
    <time class="post-card__date" datetime={date}>{formattedDate}</time>
  </div>
</article>
