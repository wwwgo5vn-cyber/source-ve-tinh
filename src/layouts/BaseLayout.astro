---
import '../styles/global.css'
import { getSite } from '../config/site'

interface Props {
  title: string
  description: string
  canonical?: string
  ogImage?: string
  ogImageWidth?: number
  ogImageHeight?: number
  type?: 'website' | 'article'
  publishedAt?: string
  updatedAt?: string
  breadcrumbs?: { name: string; url: string }[]
  noindex?: boolean
  extraSchema?: object | object[]
}

const site = getSite()
const {
  title,
  description,
  canonical,
  ogImage = site.ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  type = 'website',
  publishedAt,
  updatedAt,
  breadcrumbs,
  noindex = false,
  extraSchema
} = Astro.props

const siteUrl    = site.origin
const pageUrl    = canonical ?? siteUrl + Astro.url.pathname
const siteTitle  = site.name
const authorName = site.author.name
const fullTitle  = title === siteTitle ? title : `${title} — ${siteTitle}`
const ogImageAbs = siteUrl + ogImage
const gaId = site.gaId || ''
---
<!doctype html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  {gaId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}

  <!-- Preload self-hosted Roboto (latin 400) -->
  <link rel="preload" as="font" type="font/woff2" href="/fonts/roboto-latin-400-normal.woff2" crossorigin />

  <!-- Primary SEO -->
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author"      content={authorName} />
  <meta name="robots"      content={noindex ? 'noindex, nofollow' : 'index, follow'} />
  <link rel="canonical"    href={pageUrl} />

  <!-- Open Graph -->
  <meta property="og:type"         content={type} />
  <meta property="og:url"          content={pageUrl} />
  <meta property="og:title"        content={fullTitle} />
  <meta property="og:description"  content={description} />
  <meta property="og:image"        content={ogImageAbs} />
  <meta property="og:image:alt"    content={fullTitle} />
  <meta property="og:image:width"  content={String(ogImageWidth)} />
  <meta property="og:image:height" content={String(ogImageHeight)} />
  <meta property="og:locale"       content="vi_VN" />
  <meta property="og:site_name"    content={siteTitle} />

  <!-- Twitter Card -->
  <meta name="twitter:card"        content="summary_large_image" />
  <meta name="twitter:title"       content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image"       content={ogImageAbs} />

  <!-- Article meta -->
  {type === 'article' && publishedAt && (
    <meta property="article:published_time" content={publishedAt} />
  )}
  {type === 'article' && updatedAt && (
    <meta property="article:modified_time" content={updatedAt} />
  )}

  <!-- Preload LCP image (cover bài viết) -->
  {type === 'article' && ogImage && ogImage !== site.ogImage && (
    <link rel="preload" as="image" href={ogImage} fetchpriority="high" />
  )}

  <!-- Favicon + Touch Icon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Theme color -->
  <meta name="theme-color" content="#1a1a1a" />

  <!-- Sitemap -->
  <link rel="sitemap" href="/sitemap-index.xml" />

  <!-- JSON-LD: BlogPosting / CollectionPage -->
  {type === 'article' ? (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": title,
      "description": description,
      "inLanguage": "vi",
      "datePublished": publishedAt,
      "dateModified": updatedAt ?? publishedAt,
      "author": { "@type": "Person", "name": authorName },
      "publisher": {
        "@type": "Organization",
        "name": siteTitle,
        "logo": { "@type": "ImageObject", "url": siteUrl + "/images/logo.png" }
      },
      "mainEntityOfPage": { "@type": "WebPage", "@id": pageUrl },
      "image": { "@type": "ImageObject", "url": ogImageAbs, "width": ogImageWidth, "height": ogImageHeight }
    })} />
  ) : (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": title,
      "url": pageUrl,
      "description": description,
      "inLanguage": "vi",
      "isPartOf": {
        "@type": "WebSite",
        "name": siteTitle,
        "url": siteUrl
      }
    })} />
  )}

  <!-- JSON-LD: BreadcrumbList -->
  {breadcrumbs && breadcrumbs.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbs.map((crumb, i) => ({
        "@type": "ListItem",
        "position": i + 1,
        "name": crumb.name,
        "item": crumb.url
      }))
    })} />
  )}

  <!-- JSON-LD: Organization (sitewide) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": siteTitle,
    "url": siteUrl,
    "logo": {
      "@type": "ImageObject",
      "url": siteUrl + "/images/logo.png"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": site.contact.phone,
      "email": site.contact.email,
      "contactType": "customer service",
      "areaServed": "VN",
      "availableLanguage": "vi"
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": site.contact.address,
      "addressLocality": "Thành phố Thủ Đức",
      "addressRegion": "Thành phố Hồ Chí Minh",
      "addressCountry": "VN"
    },
    "sameAs": [
      site.contact.parentUrl,
      site.contact.zalo
    ]
  })} />

  <!-- JSON-LD: Extra (page-specific) -->
  {extraSchema && (Array.isArray(extraSchema) ? extraSchema : [extraSchema]).map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}
</head>
<body>

  <a href="#main-content" class="skip-link">Chuyển đến nội dung chính</a>

  <header class="site-header" role="banner">
    <div class="site-header__inner">
      <a href="/" class="site-header__icon" aria-label="Trang chủ blog">
        <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect width="40" height="40" rx="8" fill="#1a1a1a"/>
          <path d="M10 13h20M10 19h14M10 25h17" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
          <circle cx="29" cy="27" r="5" fill="#fff" opacity=".15"/>
          <path d="M27 27l1.5 1.5L31 25" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
      <div class="site-header__right">
        <a href="/" class="site-header__logo" aria-label={`${siteTitle} — Trang chủ`}>{siteTitle}</a>
        <div class="site-header__bottom">
          <nav class="site-header__nav" aria-label="Điều hướng chính">
            <a href={`mailto:${site.contact.email}`} class="site-header__contact-btn">✉ Email</a>
            <a href={site.contact.zalo} target="_blank" rel="noopener noreferrer" class="site-header__contact-btn site-header__contact-btn--zalo">✆ Zalo</a>
            <a href={`tel:${site.contact.phone}`} class="site-header__contact-btn site-header__contact-btn--hotline">☎ Hotline</a>
          </nav>
          <form class="site-search" action="/tim-kiem" method="get" role="search">
            <input
              class="site-search__input"
              type="search"
              name="q"
              placeholder="Tìm kiếm..."
              aria-label="Tìm kiếm bài viết"
              autocomplete="off"
            />
            <button class="site-search__btn" type="submit" aria-label="Tìm">
              <svg width="14" height="14" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="2"/>
                <path d="M13 13l4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </form>
        </div>
      </div>
    </div>
  </header>

  <main id="main-content" tabindex="-1">
    <slot />
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="site-footer__btns">
      <a href={`mailto:${site.contact.email}`} class="footer-btn footer-btn--web">✉ Email: {site.contact.email}</a>
      <a href={site.contact.zalo} target="_blank" rel="noopener noreferrer" class="footer-btn footer-btn--zalo">✆ Zalo: {site.contact.phoneDisplay}</a>
      <a href={`tel:${site.contact.phone}`} class="footer-btn footer-btn--hotline">☎ Hotline: {site.contact.phoneDisplay}</a>
    </div>
    <p class="site-footer__address">{site.contact.address}</p>
    <p>Copyright {new Date().getFullYear()} © {site.domain}</p>
  </footer>

</body>
</html>
