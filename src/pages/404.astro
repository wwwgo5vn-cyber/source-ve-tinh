---
import BaseLayout from '../layouts/BaseLayout.astro'
import TagBadge from '../components/TagBadge.astro'
import { getSite } from '../config/site'
import { getPublishedPosts } from '../lib/posts'

const site = getSite()
const siteUrl = site.origin

const posts = await getPublishedPosts()
const recent = posts.slice(0, 5)

const tagCount: Record<string, number> = {}
posts.forEach(post => {
  post.data.tags.forEach(tag => {
    tagCount[tag] = (tagCount[tag] || 0) + 1
  })
})
const popularTags = Object.entries(tagCount)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8)
  .map(([tag]) => tag)

const breadcrumbs = [
  { name: 'Trang chủ', url: siteUrl + '/' },
  { name: '404', url: siteUrl + '/404' },
]
---
<BaseLayout
  title="404 — Không tìm thấy trang"
  description={`Trang bạn tìm không tồn tại hoặc đã bị xoá trên ${site.name}.`}
  noindex={true}
  breadcrumbs={breadcrumbs}
>
  <div class="container">
    <div class="prose">

      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol class="breadcrumb__list">
          <li class="breadcrumb__item"><a href="/">Trang chủ</a></li>
          <li class="breadcrumb__item breadcrumb__item--sep" aria-hidden="true">›</li>
          <li class="breadcrumb__item"><span>404</span></li>
        </ol>
      </nav>

      <section class="not-found" aria-labelledby="not-found-title">
        <p class="not-found__code" aria-hidden="true">404</p>
        <p class="not-found__label">Lỗi</p>
        <h1 id="not-found-title" class="not-found__title">Không tìm thấy trang</h1>
        <p class="not-found__desc">
          Đường dẫn không tồn tại, đã đổi URL, hoặc bài viết đã bị gỡ.
          Bạn có thể về trang chủ, tìm kiếm, hoặc xem bài mới bên dưới.
        </p>

        <div class="not-found__actions">
          <a href="/" class="not-found__btn not-found__btn--primary">← Về trang chủ</a>
          <a href="/tim-kiem" class="not-found__btn">Tìm kiếm bài viết</a>
          <a href="/tag/" class="not-found__btn">Xem theo tag</a>
        </div>
      </section>

      {popularTags.length > 0 && (
        <section class="not-found-section" aria-labelledby="not-found-tags-title">
          <h2 id="not-found-tags-title" class="not-found-section__title">Chủ đề phổ biến</h2>
          <div class="not-found-section__tags">
            {popularTags.map(tag => <TagBadge tag={tag} />)}
          </div>
        </section>
      )}

      {recent.length > 0 && (
        <section class="not-found-section" aria-labelledby="not-found-recent-title">
          <h2 id="not-found-recent-title" class="not-found-section__title">Bài viết mới</h2>
          <ul class="not-found-recent">
            {recent.map(post => (
              <li class="not-found-recent__item">
                <a href={`/${post.publicSlug}/`} class="not-found-recent__link">{post.data.title}</a>
                <time class="not-found-recent__date" datetime={post.data.date}>
                  {new Date(post.data.date).toLocaleDateString('vi-VN', {
                    year: 'numeric', month: 'long', day: 'numeric'
                  })}
                </time>
              </li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </div>
</BaseLayout>

<style>
.not-found {
  padding: 2.5rem 0 2rem;
  border-bottom: 1px solid var(--color-border);
  margin-bottom: 2rem;
  text-align: center;
}
.not-found__code {
  font-family: var(--font-ui);
  font-size: clamp(4rem, 12vw, 6rem);
  font-weight: 700;
  line-height: 1;
  letter-spacing: -.04em;
  color: var(--color-border);
  margin-bottom: .75rem;
}
.not-found__label {
  font-family: var(--font-ui);
  font-size: var(--size-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: var(--color-accent);
  margin-bottom: .75rem;
}
.not-found__title {
  font-size: var(--size-2xl);
  letter-spacing: -.02em;
  margin-bottom: .75rem;
}
.not-found__desc {
  font-family: var(--font-ui);
  font-size: var(--size-sm);
  color: var(--color-muted);
  line-height: 1.7;
  max-width: 34rem;
  margin: 0 auto 1.75rem;
}
.not-found__actions {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
  justify-content: center;
}
.not-found__btn {
  display: inline-block;
  padding: .65rem 1.15rem;
  font-family: var(--font-ui);
  font-size: var(--size-sm);
  font-weight: 600;
  border: 1px solid var(--color-border);
  border-radius: 6px;
  background: var(--color-surface);
  color: var(--color-text);
  text-decoration: none;
  transition: border-color .15s, background .15s, opacity .15s;
}
.not-found__btn:hover {
  opacity: 1;
  background: var(--color-accent-light);
  border-color: var(--color-accent);
  color: var(--color-accent);
}
.not-found__btn--primary {
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: #fff;
}
.not-found__btn--primary:hover {
  opacity: .85;
  background: var(--color-accent);
  border-color: var(--color-accent);
  color: #fff;
}

.not-found-section {
  margin-bottom: 2.25rem;
}
.not-found-section__title {
  font-size: var(--size-lg);
  font-weight: 700;
  letter-spacing: -.02em;
  margin-bottom: 1rem;
}
.not-found-section__tags {
  display: flex;
  flex-wrap: wrap;
  gap: .5rem;
}

.not-found-recent {
  list-style: none;
  padding: 0;
  margin: 0;
}
.not-found-recent__item {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 1rem;
  padding: .75rem 0;
  border-bottom: 1px solid var(--color-border);
}
.not-found-recent__item:last-child { border-bottom: none; }
.not-found-recent__link {
  font-size: var(--size-base);
  color: var(--color-text);
  text-decoration: none;
  flex: 1;
  line-height: 1.4;
}
.not-found-recent__link:hover {
  color: var(--color-accent);
  text-decoration: underline;
  text-underline-offset: 3px;
  opacity: 1;
}
.not-found-recent__date {
  font-family: var(--font-ui);
  font-size: var(--size-xs);
  color: var(--color-muted);
  white-space: nowrap;
  flex-shrink: 0;
}

@media (max-width: 640px) {
  .not-found { padding: 1.75rem 0 1.5rem; }
  .not-found__title { font-size: var(--size-xl); }
  .not-found-recent__item { flex-direction: column; gap: .25rem; }
}
</style>
